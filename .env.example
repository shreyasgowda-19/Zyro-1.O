# PayGuard 360 Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security
JWT_SECRET=demo-secret-key-payguard-360-replace-in-production-long-secure
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Database
DATABASE_URL=sqlite:///./payguard.db

# Demo Mode (Required for simulator, scenario injection, and fast reset)
DEMO_MODE=true

# Rules
RULES_CONFIG_PATH=app/risk_rules.json
